<Window x:Class="VoiceTyper.App.Overlay.RecordingOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoiceTyper.App.Overlay"
        Width="480" Height="148" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False">
    <Border Background="#F21B2433" CornerRadius="18" Padding="22,16" BorderBrush="#40546A" BorderThickness="1">
        <StackPanel>
            <Grid>
                <TextBlock x:Name="Status" Foreground="#AFC8E8" Text="正在聆听 · 松开右 Alt 完成" FontSize="12" />
                <local:Waveform x:Name="Wave" Width="110" Height="24" HorizontalAlignment="Right" />
            </Grid>
            <TextBlock x:Name="Transcript" Foreground="White" FontSize="17" Margin="0,12,0,0"
                       TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis" Text="请说话…" />
        </StackPanel>
    </Border>
</Window>
