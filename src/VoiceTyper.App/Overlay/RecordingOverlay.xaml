<Window x:Class="VoiceTyper.App.Overlay.RecordingOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoiceTyper.App.Overlay"
        Width="480" SizeToContent="Height" MinHeight="92" MaxHeight="164" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False">
    <Border Background="#F21B2433" CornerRadius="18" Padding="22,16" BorderBrush="#40546A" BorderThickness="1">
        <StackPanel>
            <local:Waveform x:Name="Wave" Width="132" Height="28" HorizontalAlignment="Center" />
            <ScrollViewer x:Name="TranscriptScroll" Margin="0,12,0,0" MinHeight="24" MaxHeight="72"
                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="Transcript" Foreground="White" FontSize="17" TextWrapping="Wrap"
                           LineHeight="24" LineStackingStrategy="BlockLineHeight" Text="请说话…" />
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
