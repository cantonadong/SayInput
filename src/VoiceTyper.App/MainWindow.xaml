<Window x:Class="VoiceTyper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceTyper · 热键与窗口测试" Width="580" Height="470"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="28">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Right Alt 与目标窗口测试" />
        <TextBlock Margin="0,12,0,18" TextWrapping="Wrap"
                   Text="点击开始后，切换到记事本，按住右 Alt 5 秒再松开。每次应只增加一次按下和一次松开。此版本尚不录音，也不连接云端。" />
        <StackPanel Orientation="Horizontal">
            <Button x:Name="StartButton" Padding="18,8" Click="StartClicked" Content="开始测试" />
            <Button x:Name="StopButton" Margin="12,0,0,0" Padding="18,8" Click="StopClicked"
                    Content="停止测试" IsEnabled="False" />
        </StackPanel>
        <TextBlock x:Name="Counts" Margin="0,20,0,0" FontSize="18" Text="按下 0 次 · 松开 0 次" />
        <TextBlock x:Name="Status" Margin="0,12,0,0" TextWrapping="Wrap" Text="未启用热键；关闭窗口会释放 Hook。" />
        <TextBlock x:Name="Target" Margin="0,16,0,0" TextWrapping="Wrap" MaxHeight="110" TextTrimming="CharacterEllipsis" Text="按下右 Alt 后，这里显示当时的目标窗口。" />
    </StackPanel>
</Window>
