<Window x:Class="VoiceTyper.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VoiceTyper · 设置" Width="600" Height="760" MinHeight="600" WindowStartupLocation="CenterScreen">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
  <TextBlock FontSize="24" FontWeight="SemiBold" Text="点按右 Alt，开始或结束语音输入" />
  <TextBlock Margin="0,10,0,18" TextWrapping="Wrap" Text="保存凭据后，点击其他应用的输入位置：按一下右 Alt 开始录音，再按一下结束并输入文字。最小化或关闭此窗口后仍在系统托盘运行。" />
  <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
   <CheckBox x:Name="EnabledOption" Content="启用" Margin="0,0,20,0" /><CheckBox x:Name="StartupOption" Content="开机启动" Margin="0,0,20,0" /><CheckBox x:Name="PartialOption" Content="显示实时文字" />
  </StackPanel>
  <TextBlock Text="麦克风" FontWeight="SemiBold" /><ComboBox x:Name="Devices" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,8,0,8" />
  <StackPanel Orientation="Horizontal"><Button Content="刷新设备" Click="RefreshDevicesClicked" Padding="12,5" /><Button x:Name="LevelButton" Content="测试音量（10 秒）" Click="LevelClicked" Margin="10,0,0,0" Padding="12,5" /></StackPanel>
  <ProgressBar x:Name="LevelMeter" Height="8" Maximum="1" Margin="0,10,0,20" />
  <TextBlock Text="火山引擎" FontSize="17" FontWeight="SemiBold" />
  <TextBlock Text="App ID（使用 Access Token 时填写）" Margin="0,10,0,4" /><TextBox x:Name="AppIdBox" Padding="6" />
  <TextBlock Text="Access Token" Margin="0,8,0,4" /><PasswordBox x:Name="TokenBox" Padding="6" />
  <TextBlock Text="或 API Key（填写后优先使用）" Margin="0,8,0,4" /><PasswordBox x:Name="ApiKeyBox" Padding="6" />
  <TextBlock Text="Resource ID" Margin="0,8,0,4" /><TextBox x:Name="ResourceBox" Padding="6" />
  <TextBlock Margin="0,10,0,12" TextWrapping="Wrap" Foreground="#666666" Text="语音会发送到火山引擎进行云识别；本机不保存音频或转写历史。凭据使用当前 Windows 用户加密保护。连接测试不采集麦克风。" />
  <StackPanel Orientation="Horizontal"><Button x:Name="SaveButton" Content="保存设置" Click="SaveClicked" Padding="18,8" /><Button x:Name="ConnectionButton" Content="测试连接" Click="ConnectionClicked" Margin="10,0,0,0" Padding="18,8" /></StackPanel>
  <TextBlock x:Name="Status" Margin="0,14,0,8" TextWrapping="Wrap" Text="请填写凭据并保存，然后到记事本试用。" />
  <TextBox x:Name="RecoveryText" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" />
  <TextBlock x:Name="Metrics" TextWrapping="Wrap" FontSize="11" Foreground="#666666" Margin="0,10,0,0" />
  <Button Content="退出程序" Click="ExitClicked" HorizontalAlignment="Right" Padding="14,6" Margin="0,12,0,0" />
 </StackPanel></ScrollViewer>
</Window>
