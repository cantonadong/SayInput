<Window x:Class="VoiceTyper.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SayInput · 设置" Width="430" Height="700" MinWidth="410" MinHeight="640" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style TargetType="Button"><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="15,5" /></Style>
 </Window.Resources>
 <Grid Margin="24,18,24,20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" /><RowDefinition Height="18" />
   <RowDefinition Height="Auto" /><RowDefinition Height="18" />
   <RowDefinition Height="Auto" /><RowDefinition Height="18" />
   <RowDefinition Height="Auto" /><RowDefinition Height="8" />
   <RowDefinition Height="Auto" /><RowDefinition Height="18" />
   <RowDefinition Height="*" /><RowDefinition Height="20" />
   <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
   <Image x:Name="BrandIcon" Width="42" Height="42" Stretch="Uniform" Margin="0,0,12,0" />
   <TextBlock Text="SayInput 设置" FontWeight="SemiBold" FontSize="16" />
  </StackPanel>

  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <TextBlock Text="设置项" FontWeight="SemiBold" />
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <CheckBox x:Name="StartupOption" Content="开机启动" VerticalAlignment="Center" Margin="0,0,26,0" Checked="PreferenceChanged" Unchecked="PreferenceChanged" />
    <CheckBox x:Name="PartialOption" Content="显示实时文字" VerticalAlignment="Center" Checked="PreferenceChanged" Unchecked="PreferenceChanged" />
   </StackPanel>
  </Grid>

  <Grid Grid.Row="4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <TextBlock Text="使用方式" FontWeight="SemiBold" />
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <RadioButton x:Name="HoldMode" GroupName="TriggerMode" Content="按住" VerticalAlignment="Center" Margin="0,0,46,0" Checked="PreferenceChanged" />
    <RadioButton x:Name="ToggleMode" GroupName="TriggerMode" Content="点击" VerticalAlignment="Center" Checked="PreferenceChanged" />
   </StackPanel>
  </Grid>

  <Grid Grid.Row="6">
   <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
   <TextBlock Text="麦克风" FontWeight="SemiBold" />
   <ComboBox x:Name="Devices" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" SelectionChanged="PreferenceChanged" />
   <Button x:Name="LevelButton" Grid.Column="2" Content="测试" Click="LevelClicked" />
  </Grid>
  <ProgressBar x:Name="LevelMeter" Grid.Row="8" Height="14" Maximum="1" Margin="64,0,0,0" Foreground="#20D83B" />

  <TabControl x:Name="SettingsTabs" Grid.Row="10" SelectedIndex="1">
   <TabItem Header="文字润色" IsEnabled="False" />
   <TabItem Header="语音识别">
    <Grid Margin="14,12,14,14">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="32" /><RowDefinition Height="14" />
      <RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="32" /><RowDefinition Height="14" />
      <RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="32" /><RowDefinition Height="14" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
     </Grid.RowDefinitions>
     <TextBlock Grid.Row="0" Text="服务商" FontWeight="SemiBold" />
     <ComboBox x:Name="ProviderBox" Grid.Row="2" SelectedIndex="0" VerticalContentAlignment="Center">
      <ComboBoxItem Content="火山引擎" />
     </ComboBox>
     <TextBlock Grid.Row="4" Text="API Key" />
     <PasswordBox x:Name="ApiKeyBox" Grid.Row="6" Padding="7,5" />
     <TextBlock Grid.Row="8" Text="Resource ID" />
     <TextBox x:Name="ResourceBox" Grid.Row="10" Padding="7,5" />
     <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Center">
      <Button x:Name="CredentialButton" Content="编辑" Click="CredentialClicked" MinWidth="82" />
      <Button x:Name="ConnectionButton" Content="测试连接" Click="ConnectionClicked" MinWidth="92" Margin="8,0,0,0" />
     </StackPanel>
     <TextBlock x:Name="Status" Grid.Row="13" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Text="请填写凭据并保存，然后到其他应用试用。" />
     <TextBox x:Name="RecoveryText" Grid.Row="14" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="55" VerticalScrollBarVisibility="Auto" />
    </Grid>
   </TabItem>
  </TabControl>

  <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Center">
   <Button x:Name="SaveButton" Content="保存" Click="SaveClicked" MinWidth="92" />
   <Button Content="最小化" Click="MinimizeClicked" MinWidth="92" Margin="10,0,0,0" />
   <Button Content="退出" Click="ExitClicked" MinWidth="92" Margin="10,0,0,0" />
  </StackPanel>
 </Grid>
</Window>
